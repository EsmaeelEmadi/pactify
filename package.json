{
  "name": "@esmaeel_emadi/pactify",
  "version": "0.2.0",
  "description": "AST-powered Swagger/OpenAPI auto-generation for NestJS controllers. Parses TypeScript source to extract DTOs, response types, and error types — no manual @ApiResponse decorators needed.",
  "license": "MIT",
  "author": "emadi68moh@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/EsmaeelEmadi/pactify"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "format": "npx @biomejs/biome format --write .",
    "lint": "npx @biomejs/biome lint --write .",
    "check": "npx @biomejs/biome check --write .",
    "hooks:install": "npx lefthook install",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/swagger": ">=7",
    "oxc-parser": ">=0.50",
    "oxc-walker": ">=0.5",
    "ts-pattern": ">=5",
    "typescript": ">=5"
  },
  "keywords": [
    "nestjs",
    "swagger",
    "openapi",
    "ast",
    "codegen",
    "dto",
    "auto-documentation"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "lefthook": "^1.11.13"
  }
}
